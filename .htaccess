RewriteEngine On

# Redirect all requests to index.php for API routes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^(.*)$ index.php [QSA,L]

# Protect sensitive files
<FilesMatch "^(config\.json|\.git.*|composer\.json|composer\.lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>
